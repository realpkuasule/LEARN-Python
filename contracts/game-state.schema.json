{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://python-dragonquest.local/contracts/game-state.schema.json",
  "title": "Python DragonQuest Local Game State",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "hero", "progress", "inventory", "settings"],
  "properties": {
    "version": { "const": 1 },
    "hero": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "avatarId", "createdAt", "level", "totalExp", "coins", "baseStats", "title", "equipment"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1, "maxLength": 16 },
        "avatarId": { "type": "integer", "minimum": 1, "maximum": 10 },
        "createdAt": { "type": "string", "format": "date-time" },
        "level": { "type": "integer", "minimum": 1 },
        "totalExp": { "type": "integer", "minimum": 0 },
        "coins": { "type": "integer", "minimum": 0 },
        "baseStats": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maxHp", "maxMp", "atk", "def"],
          "properties": {
            "maxHp": { "type": "integer", "minimum": 1 },
            "maxMp": { "type": "integer", "minimum": 0 },
            "atk": { "type": "integer", "minimum": 0 },
            "def": { "type": "integer", "minimum": 0 }
          }
        },
        "title": { "type": "string" },
        "equipment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["weapon", "helmet", "armor", "shield", "accessory", "boots"],
          "properties": {
            "weapon": { "type": ["string", "null"] },
            "helmet": { "type": ["string", "null"] },
            "armor": { "type": ["string", "null"] },
            "shield": { "type": ["string", "null"] },
            "accessory": { "type": ["string", "null"] },
            "boots": { "type": ["string", "null"] }
          }
        }
      }
    },
    "progress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currentChapter", "completedChapters", "attempts"],
      "properties": {
        "currentChapter": { "type": "integer", "minimum": 1, "maximum": 17 },
        "completedChapters": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1, "maximum": 17 }
        },
        "attempts": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "inventory": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["itemId", "quantity"],
        "properties": {
          "itemId": { "type": "string", "minLength": 1 },
          "quantity": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["soundEnabled", "reducedMotion"],
      "properties": {
        "soundEnabled": { "type": "boolean" },
        "reducedMotion": { "type": "boolean" }
      }
    }
  }
}
