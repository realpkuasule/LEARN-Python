{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://python-dragonquest.local/contracts/game-state.schema.json",
  "title": "Python DragonQuest Local Game State",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "hero", "progress", "inventory", "achievements", "settings"],
  "properties": {
    "version": { "const": 4 },
    "hero": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "avatarId", "createdAt", "level", "totalExp", "coins", "baseStats", "title", "equipment"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1, "maxLength": 16 },
        "avatarId": { "type": "integer", "minimum": 1, "maximum": 10 },
        "createdAt": { "type": "string", "format": "date-time" },
        "level": { "type": "integer", "minimum": 1 },
        "totalExp": { "type": "integer", "minimum": 0 },
        "coins": { "type": "integer", "minimum": 0 },
        "baseStats": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maxHp", "maxMp", "atk", "def"],
          "properties": {
            "maxHp": { "type": "integer", "minimum": 1 },
            "maxMp": { "type": "integer", "minimum": 0 },
            "atk": { "type": "integer", "minimum": 0 },
            "def": { "type": "integer", "minimum": 0 }
          }
        },
        "title": {
          "type": "string",
          "enum": [
            "",
            "初出茅庐",
            "史莱姆克星",
            "条件判断克星",
            "循环克星",
            "函数克星",
            "数据结构大师",
            "文件操作大师",
            "错误处理大师",
            "装备收藏家",
            "提示药水品鉴师",
            "所以你问的谁",
            "速通达人",
            "赤帝之子",
            "资本家",
            "这个称号有点难度",
            "人工智能"
          ]
        },
        "equipment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["weapon", "helmet", "armor", "shield", "accessory", "boots"],
          "properties": {
            "weapon": { "type": ["string", "null"] },
            "helmet": { "type": ["string", "null"] },
            "armor": { "type": ["string", "null"] },
            "shield": { "type": ["string", "null"] },
            "accessory": { "type": ["string", "null"] },
            "boots": { "type": ["string", "null"] }
          }
        }
      }
    },
    "progress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currentChapter", "completedChapters", "attempts", "hintsRevealed", "storyCheckpoints"],
      "properties": {
        "currentChapter": { "type": "integer", "minimum": 1, "maximum": 17 },
        "completedChapters": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1, "maximum": 17 }
        },
        "attempts": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "hintsRevealed": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0, "maximum": 3 }
        },
        "storyCheckpoints": {
          "type": "object",
          "propertyNames": { "pattern": "^(?:[1-9]|1[0-7])$" },
          "additionalProperties": {
            "type": "array",
            "maxItems": 10,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z0-9-]{1,64}$" }
          }
        }
      }
    },
    "inventory": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["itemId", "quantity"],
        "properties": {
          "itemId": { "type": "string", "minLength": 1 },
          "quantity": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "achievements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unlockedTitles", "aiRequests"],
      "properties": {
        "unlockedTitles": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "初出茅庐",
              "史莱姆克星",
              "条件判断克星",
              "循环克星",
              "函数克星",
              "数据结构大师",
              "文件操作大师",
              "错误处理大师",
              "装备收藏家",
              "提示药水品鉴师",
              "所以你问的谁",
              "速通达人",
              "赤帝之子",
              "资本家",
              "这个称号有点难度",
              "人工智能"
            ]
          }
        },
        "aiRequests": { "type": "integer", "minimum": 0 }
      }
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["soundEnabled", "sfxVolume", "reducedMotion"],
      "properties": {
        "soundEnabled": { "type": "boolean" },
        "sfxVolume": { "type": "number", "minimum": 0, "maximum": 1 },
        "reducedMotion": { "type": "boolean" }
      }
    }
  }
}
